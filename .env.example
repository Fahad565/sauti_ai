# Sauti AI - example environment configuration
# Copy this file to `.env` and adjust values for your local setup.

# --- Service identity -------------------------------------------
SERVICE_NAME=Sauti AI
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- NVIDIA hosted Gemma 4 (Sprint 2 / Feature 1.2) -------------
# Get a free key at https://build.nvidia.com
# Leave NVIDIA_API_KEY unset to disable the real LLM (the analyze
# node will raise a clear configuration error if it is invoked).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=google/gemma-4-31b-it
NVIDIA_TIMEOUT_SECONDS=120
NVIDIA_MAX_TOKENS=512
NVIDIA_TEMPERATURE=1.0
NVIDIA_TOP_P=0.95
NVIDIA_ENABLE_THINKING=true

# --- Multi-provider LLM backend (Sprint 4) -----------------------
# Selects the active backend. Supported: "google" (default) or "nvidia".
LLM_PROVIDER=google
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1

# --- Google AI Studio (Gemini) ------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# --- Twilio WhatsApp Sandbox (Sprint 3 / Feature 1.3) ------------
# The webhook route itself is unauthenticated for local development
# (per the Feature 1.3 acceptance criteria). However, when
# WEBHOOK_ASYNC_MODE=true (the default, see DECISION-0014) the
# webhook returns empty TwiML immediately and sends the agent reply
# through the Twilio REST API. Outbound delivery requires all three
# of the values below to be set; otherwise the reply is *logged but
# never delivered* — which reproduces the DEBUG.md symptom where
# ngrok shows a 200 OK but WhatsApp never receives a message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=whatsapp:+14155238886

# --- Async webhook mode (DECISION-0014) ---------------------------
# When true (default) the webhook acknowledges Twilio within a few
# hundred milliseconds with an empty TwiML body, then runs the
# LangGraph pipeline + LLM call inside a FastAPI BackgroundTask
# and delivers the final reply via the Twilio REST API. This
# avoids Twilio's ~15 s webhook timeout on cold LLM starts.
# Set to false only for local demos where you want TwiML in the
# HTTP response body.
WEBHOOK_ASYNC_MODE=true
